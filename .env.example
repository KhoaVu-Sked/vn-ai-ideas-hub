# Neon Postgres connection string (Neon dashboard → Connect → use the POOLED string).
# Looks like: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies. Generate a strong random value, e.g.:
#   openssl rand -base64 32
# Set the SAME value locally and in Vercel. Never commit the real value.
AUTH_SECRET=change-me-to-a-long-random-string

# Email notifications (Resend). Leave RESEND_API_KEY blank to disable email.
RESEND_API_KEY=
# Sender address. Use a verified domain in production, or Resend's test sender:
MAIL_FROM=AI Ideas Hub <onboarding@resend.dev>
# Base URL used for links in emails (falls back to the request origin if unset):
APP_URL=https://your-app.vercel.app

# File uploads use Vercel Blob. On Vercel, connect a Blob store to the project —
# it authenticates via OIDC (sets BLOB_STORE_ID), no token needed.
# For LOCAL uploads (npm run dev), OIDC isn't available, so set a read-write token:
BLOB_READ_WRITE_TOKEN=
