# Neon Postgres connection string (Neon dashboard → Connect → use the POOLED string).
# Looks like: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies. Generate a strong random value, e.g.:
#   openssl rand -base64 32
# Set the SAME value locally and in Vercel. Never commit the real value.
AUTH_SECRET=change-me-to-a-long-random-string

# Email notifications. Set EITHER an SMTP account OR a Resend key; with neither,
# the app simply doesn't send (no errors).
#
# Option A — SMTP (e.g. Gmail with an App Password; needs 2-Step Verification):
SMTP_USER=
SMTP_PASS=
# Optional, defaults to Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# Option B — Resend (needs a domain verified in Resend):
RESEND_API_KEY=
#
# Sender. The display name is yours to choose; over SMTP the address is forced
# to SMTP_USER, since Gmail only sends as the authenticated account.
MAIL_FROM=TS - AI Ideas Hub <you@gmail.com>
# Base URL used for links in emails (falls back to the request origin if unset):
APP_URL=https://your-app.vercel.app

# File uploads use Vercel Blob. On Vercel, connect a Blob store to the project —
# it authenticates via OIDC (sets BLOB_STORE_ID), no token needed.
# For LOCAL uploads (npm run dev), OIDC isn't available, so set a read-write token:
BLOB_READ_WRITE_TOKEN=

# Google sign-in (optional). Create an OAuth 2.0 Web application client in the
# Google Cloud console, then register the callback URL for EVERY environment you
# use — Google matches it exactly:
#   https://your-app.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# With these unset, the app hides the Google button and password sign-in is the
# only route in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auto Schedule (Up next → Google Calendar). By default reuses the SAME
# OAuth client as Google sign-in above (GOOGLE_CLIENT_ID/SECRET) — if you have
# edit access to that Cloud project:
#   1. Enable the "Google Calendar API" for that Cloud project.
#   2. OAuth consent screen → Scopes → add calendar.freebusy + calendar.events.
#   3. Credentials → that OAuth client → Authorized redirect URIs → add:
#        https://your-app.vercel.app/api/calendar/connect/callback
#        http://localhost:3000/api/calendar/connect/callback
#
# Don't have edit access to that client (e.g. testing from a UAT deploy you
# don't own)? Set these two instead — a client under YOUR OWN Google account,
# entirely separate from the shared sign-in client, no one else's permission
# needed. When set, these take priority over GOOGLE_CLIENT_ID/SECRET for
# calendar access ONLY; sign-in is untouched either way.
#   1. console.cloud.google.com, any Google account → New Project.
#   2. Enable "Google Calendar API".
#   3. OAuth consent screen → External, Testing → add the same two scopes →
#      add test users (up to 100) by email — anyone who'll click through the
#      demo, e.g. your own @skedulo.com address.
#   4. Credentials → Create Credentials → OAuth client ID → Web application →
#      Authorized redirect URIs → the callback URL(s) above, matching
#      whichever origin(s) you're actually demoing from.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Key used to encrypt the stored Google refresh token at rest. Generate one:
#   openssl rand -base64 32
# Set the SAME value locally and in Vercel. Never commit the real value.
CALENDAR_TOKEN_KEY=
# Realtime (optional). Without it the app falls back to refetch-on-focus.
# Injected by the Redis integration in Vercel → Storage → Marketplace. KV_URL is
# accepted too, since not every integration uses the same name. Upstash and
# Redis Cloud are TLS, so the real value starts rediss:// — that is correct.
REDIS_URL=rediss://default:password@host:6379
